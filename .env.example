# BondAI Platform Environment Variables
# Copy this file to .env and fill in your values

# ===== DATABASE =====
DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxxx@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ===== JWT & SECURITY =====
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
SESSION_SECRET=your-session-secret-key
SURETY_ADMIN_PIN=your-admin-pin-for-surety-operations

# ===== STRIPE =====
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ===== OPENAI =====
# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxx

# ===== REPLIT (Optional) =====
REPLIT_CONNECTORS_HOSTNAME=your-connectors-hostname.boltdb
REPLIT_DEPLOYMENT=1

# ===== NODE ENVIRONMENT =====
NODE_ENV=development

# ===== EMAIL (Optional) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@bondai.app

# ===== ALLOWED CORS ORIGINS =====
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,https://your-domain.replit.app
